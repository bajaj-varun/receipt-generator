# Phase 1 (local CLI) reads no environment variables - this file documents the
# settings src/config.py will load via pydantic-settings from Phase 2 onward.

# --- Application
LOG_LEVEL=INFO
DEFAULT_DEGRADATION_PRESET=worn

# --- Phase 2: Firestore template store
GCP_PROJECT_ID=your-project-id
FIRESTORE_COLLECTION=receipt_templates
# Point at the local emulator during development; unset to use real Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Phase 3: OpenTelemetry -> Cloud Trace / Cloud Logging
OTEL_SERVICE_NAME=receipt-generator
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Phase 4: Cloud Storage for rendered output
GCS_BUCKET=your-receipts-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
